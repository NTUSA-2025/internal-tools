{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "ignoreDeprecations": "6.0",
    "customConditions": ["@ntusa/internal-tools"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "baseUrl": ".",
    "paths": {
      "@internal-tools/auth": ["libs/auth/src/index.ts"],
      "@internal-tools/tool-registry": ["libs/tool-registry/src/index.ts"],
      "@internal-tools/ui": ["libs/ui/src/index.ts"]
    }
  }
}
